{
    "java.project.sourcePaths": ["src"],
    "java.project.outputPath": "bin",
    "java.project.referencedLibraries": [
        "lib/**/*.jar"
    ],
    "code-runner.executorMap": {
        "java": "cd $dir && javac -cp \"$workspaceRoot/lib/mysql-connector-j-26.7.0.jar\" $fileName && java -cp \".;$workspaceRoot/lib/mysql-connector-j-26.7.0.jar\" $fileNameWithoutExt"
    },
    "code-runner.saveFileBeforeRun": true
}
